  "layout": {
    "breakpoints": {"tablet":640,"desktop":1024},
    "grid": {
      "mobile":        {"columns":4, "gutter":16,"margin":16,"range":"320–639px"},
      "tablet":        {"columns":8, "gutter":24,"margin":32,"range":"640–1023px"},
      "desktop":       {"columns":12,"gutter":24,"margin":32,"range":"1024px+","maxContent":1200}
