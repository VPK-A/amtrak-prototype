# Copy to .env.local (ignored by git) and fill in. Used by `npm run dev` / `npm run build` only.
# Browser key restricted to the Maps JavaScript API and to your website referrers (see prototypes/sprint4/GOOGLE-MAPS.md)
VITE_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID with vector rendering, for Advanced Markers. Leave empty to use Google's DEMO_MAP_ID in development.
VITE_GOOGLE_MAPS_MAP_ID=
